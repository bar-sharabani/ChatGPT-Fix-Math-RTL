{
  "manifest_version": 3,
  "name": "ChatGPT Hebrew KaTeX LTR Fix",
  "version": "1.1",
  "description": "Force KaTeX math to be LTR on Hebrew ChatGPT pages, including while streaming.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
